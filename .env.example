# Copy this file to .env and fill in your values. Never commit .env.

# --- SQL Server ---
DB_SERVER=localhost
# For SQL Express use:  DB_SERVER=localhost\SQLEXPRESS
DB_PORT=
DB_NAME=SalesPulseDB
# Leave DB_USER and DB_PASSWORD empty to use Windows Authentication
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
TIME_ZONE=Asia/Karachi
# DB_ENGINE=sqlite   # uncomment to run the Django tests without SQL Server

# --- Data folders (defaults shown) ---
# DATA_DIR=data/raw
# ARCHIVE_DIR=data/archive
MAX_UPLOAD_MB=100
